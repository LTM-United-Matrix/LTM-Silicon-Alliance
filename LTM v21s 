    DWORD exitCode;
    bool isOvertimeActive = false;
    
    // В игровом процессе держим карту холодной — 170 Ватт
    SetGpuPowerLimit(GPU_POWER_CHILL); 

    while (GetExitCodeProcess(hProcess, &exitCode) && exitCode == STILL_ACTIVE) {
        // [Здесь твой софт наносекундным WinAPI-потоком считывает игровой FPS]
        int currentFps = 160; // Симуляция стабильной полки кадров матча

        // ТЕХНОЛОГИЯ OVERTIME: Если в трудной катке замес опустил FPS до 130 — срываем лимиты!
        if (currentFps <= 135 && !isOvertimeActive) {
            isOvertimeActive = true;
            std::cout << "[LTM OVERTIME] Всплеск нагрузки! Перевод в REALTIME и впрыск 250W мощности!" << std::endl;
