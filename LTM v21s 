// Функция, которая НАВСЕГДА сохраняет новые игры в базу на диске C:
void SaveGameToDatabase(const std::string& gameName) {
    if (std::find(DYNAMIC_GAME_LIST.begin(), DYNAMIC_GAME_LIST.end(), gameName) == DYNAMIC_GAME_LIST.end()) {
        DYNAMIC_GAME_LIST.push_back(gameName);
        std::ofstream db(DB_FILE, std::ios::app);
        if (db.is_open()) {
            db << gameName << "\n";
            db.close();
            std::cout << "[LTM v21 S] Новая игра " << gameName << " навсегодня занесена в вечный кэш!" << std::endl;
        }
    }
}

// Функция считывания всех когда-либо установленных игр при старте софта
void LoadGamesFromDatabase() {
    std::ifstream db(DB_FILE);
    if (db.is_open()) {
        std::string gameName;
        while (std::getline(db, gameName)) {
            if (!gameName.empty() && std::find(DYNAMIC_GAME_LIST.begin(), DYNAMIC_GAME_LIST.end(), gameName) == DYNAMIC_GAME_LIST.end()) {
                DYNAMIC_GAME_LIST.push_back(gameName);
            }
        }
        db.close();
    }
}

// Прямое низкоуровневое управление лимитами питания видеокарты через NVIDIA SMI
