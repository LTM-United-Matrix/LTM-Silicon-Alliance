        // 3. Высший приоритет: Ставим игре REALTIME_PRIORITY_CLASS (выше самой ОС)
        SetPriorityClass(gameHandle, REALTIME_PRIORITY_CLASS);

        // 4. Зачистка ОЗУ: Освобождаем гигабайты памяти перед каткой
        CleanSystemMemory();

        CloseHandle(gameHandle);

        // Держим режим OVERTIME активным, пока игра запущена
        while (true) {
            std::string checkName = "";
            if (FindActiveGamePid(checkName) == 0) {
                // Игра закрылась — плавно возвращаем карту в холодный режим (170W)
                SetNvidiaPowerLimit(170);
                break;
            }
            std::this_thread::sleep_for(std::chrono::seconds(5));
        }
    }
