// Умный поиск тяжелого игрового процесса на основе потоков (>15)
DWORD FindActiveGamePid(std::string& outGameName) {
    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snapshot == INVALID_HANDLE_VALUE) return 0;

    PROCESSENTRY32W pe;
    pe.dwSize = sizeof(PROCESSENTRY32W);

    if (Process32FirstW(snapshot, &pe)) {
        do {
            // Превращаем имя процесса в стандартную строку для сравнения
            std::wstring ws(pe.szExeFile);
            std::string pName(ws.begin(), ws.end());
            std::transform(pName.begin(), pName.end(), pName.begin(), ::tolower);

            // Проверяем, что процесс тяжемый (>15 потоков) и его нет в блеклисте
            if (pe.cntThreads > 15) {
                bool isSystem = false;
                for (const auto& blacklisted : SYSTEM_BLACKLIST) {
                    if (pName == blacklisted) {
                        isSystem = true;
                        break;
                    }
                }
                if (!isSystem) {
                    outGameName = pName;
                    CloseHandle(snapshot);
                    return pe.th32ProcessID;
                }
            }
        } while (Process32NextW(snapshot, &pe));
    }

    CloseHandle(snapshot);
    return 0;
}

// Жесткая очистка оперативной памяти от фонового хлама через Windows API
void CleanSystemMemory() {
    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (snapshot == INVALID_HANDLE_VALUE) return;

    PROCESSENTRY32W pe;
    pe.dwSize = sizeof(PROCESSENTRY32W);

    if (Process32FirstW(snapshot, &pe)) {
        do {
            std::wstring ws(pe.szExeFile);
            std::string pName(ws.begin(), ws.end());
            std::transform(pName.begin(), pName.end(), pName.begin(), ::tolower);

            // Пропускаем важные системные процессы из черного списка
            bool skip = false;
            for (const auto& item : SYSTEM_BLACKLIST) {
                if (pName == item) { skip = true; break; }
            }

            if (!skip) {
                HANDLE procHandle = OpenProcess(PROCESS_SET_QUOTA | PROCESS_QUERY_INFORMATION, FALSE, pe.th32ProcessID);
                if (procHandle) {
                    // Принудительно выгружаем фоновый мусор программы в файл подкачки
                    EmptyWorkingSet(procHandle); 
                    CloseHandle(procHandle);
                }
            }
        } while (Process32NextW(snapshot, &pe));
    }
    CloseHandle(snapshot);
}

// Активация режима OVERTIME и изоляция ядер при обнаружении игры
void ApplyLtmSynergyEngine(DWORD pid, const std::string& gameName) {
    HANDLE gameHandle = OpenProcess(PROCESS_SET_INFORMATION | PROCESS_QUERY_INFORMATION, FALSE, pid);
    if (gameHandle) {
        // 1. Впрыск мощности: Переводим лимиты GPU на максимум (250W)
        SetNvidiaPowerLimit(250);

        // 2. Киберспортивная изоляция: Зажимаем игру строго на потоках 0-3
