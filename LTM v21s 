// Умный фоновый распределитель потоков (Изоляция кэша L3 под нужды игры)
void OptimizeSystemThreads(DWORD gamePid) {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return;
    THREADENTRY32 te;
    te.dwSize = sizeof(THREADENTRY32);
    if (Thread32First(hSnapshot, &te)) {
        do {
            // Весь фоновый мусор (Дискорд, Стим, Браузеры) отправляем в глубокий сон
            if (te.th32OwnerProcessID != gamePid && te.th32OwnerProcessID != GetCurrentProcessId()) {
                HANDLE hThread = OpenThread(THREAD_SET_INFORMATION, FALSE, te.th32ThreadID);
                if (hThread) {
                    SetThreadPriority(hThread, THREAD_PRIORITY_LOWEST);
                    CloseHandle(hThread);
                }
            }
        } while (Thread32Next(hSnapshot, &te));
    }
    CloseHandle(hSnapshot);
}

// Универсальный наносекундный сканер процессов Windows
DWORD FindActiveGamePid(std::string& outGameName) {
    DWORD gamePid = 0;
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return 0;
    PROCESSENTRY32 pe;
    pe.dwSize = sizeof(PROCESSENTRY32);
    if (Process32First(hSnapshot, &pe)) {
        do {
            std::string pName = pe.szExeFile;
            std::transform(pName.begin(), pName.end(), pName.begin(), ::tolower);

            // 1. Ищем по нашей вечной, расширяющейся базе данных
            for (const auto& targetGame : DYNAMIC_GAME_LIST) {
                if (pName == targetGame) { gamePid = pe.th32ProcessID; outGameName = pe.szExeFile; break; }
            }
            // 2. Автоопределение новых игр по сигнатурам движков (Unity / Unreal Engine)
            if (gamePid == 0) {
                if ((pName.find("shipping") != std::string::npos || pName.find("-game") != std::string::npos || 
                     pName.find("unreal") != std::string::npos || pName.find("unity") != std::string::npos) && 
                     pName.find("service") == std::string::npos && pName.find("update") == std::string::npos) {
                    gamePid = pe.th32ProcessID; outGameName = pe.szExeFile;
                    SaveGameToDatabase(pName); // Навсегда запоминаем переустановленную игру
                    break;
                }
            }
            if (gamePid != 0) break;
        } while (Process32Next(hSnapshot, &pe));
    }
    CloseHandle(hSnapshot);
    return gamePid;
}

