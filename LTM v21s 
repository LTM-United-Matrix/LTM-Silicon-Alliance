        }
        // Как только замес окончен и нагрузка спадает — плавно возвращаем ледяной баланс
        if (currentFps >= 165 && isOvertimeActive) {
            isOvertimeActive = false;
            std::cout << "[LTM OVERTIME] Нагрузка спала. Возврат в ледяной игровой режим 170W." << std::endl;
            SetGpuPowerLimit(GPU_POWER_CHILL);
            SetPriorityClass(hProcess, HIGH_PRIORITY_CLASS);
        }

        std::this_thread::sleep_for(std::chrono::seconds(1));
