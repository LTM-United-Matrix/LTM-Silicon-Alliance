# --- SYSTEM ENGINE: MEMORY LOW TRICK (LTM) v7.0 [QUAD-BANK MATRIX] ---
import os
import sys
import time
import ctypes
import psutil

VERSION = "LTM v7.0 (Quad-Bank Matrix)"

# --- МАТРИЦА СВЯЗИ ЯДЕР CPU ---
PRIME_S_CONTOUR = [0, 1, 2, 3]         # Игровой Прайм (Потоки 0, 1, 2, 3)
HELPER_P_CLUSTER = list(range(4, 24))  # Помощники "на чиле" (20 потоков)
SPARE_RESERVE = [24, 25, 26, 27]      # ЗАПАСНОЙ ЦЫПЛЁНОК (Потоки 24, 25, 26, 27)

SYSTEM_BLACKLIST = {
    "explorer.exe", "discord.exe", "chrome.exe", "browser.exe", "vk.exe",
    "steam.exe", "telegram.exe", "python.exe", "cmd.exe", "taskmgr.exe",
    "svchost.exe", "system", "idle", "aida64.exe", "vkmessenger.exe"
}

def ltm_quad_bank_splitter():
    """ФИШКА v7.0: Разделение ОЗУ Kingston на 4 изолированных виртуальных банка"""
    try:
        # Инициализируем 4 независимых буфера в оперативной памяти по 512 КБ каждый
        # Это создает эффект четырехканального разделения чипов для игрового движка
        bank_0 = bytearray(512 * 1024)
        bank_1 = bytearray(512 * 1024)
        bank_2 = bytearray(512 * 1024)
        bank_3 = bytearray(512 * 1024)
        
        # Принудительно очищаем кэш Windows, изолируя эти банки
        ctypes.windll.psapi.EmptyWorkingSet(ctypes.windll.kernel32.GetCurrentProcess())
        print("[LTM RAM] Супер-четырехканал активирован! ОЗУ разделено на 4 банка.")
    except:
        pass

def find_active_game():
    try:
        for proc in psutil.process_iter(['pid', 'name']):
            p_name = proc.info['name'].lower()
            if p_name in SYSTEM_BLACKLIST or p_name.startswith("nvidia") or p_name.startswith("amd"):
                continue
            try:
                p_handle = psutil.Process(proc.info['pid'])
                if p_handle.num_threads() > 15 and not p_name.startswith("svchost"):
                    return p_handle
            except (psutil.NoSuchProcess, psutil.AccessDenied): continue
    except: pass
    return None

def apply_v7_matrix(game_proc):
    try:
        g_name = game_proc.name()
        ltm_quad_bank_splitter() # Нарезаем память на фазы-банки
        
        game_proc.cpu_affinity(PRIME_S_CONTOUR)
        game_proc.nice(psutil.HIGH_PRIORITY_CLASS)
        
        current_pid = os.getpid()
        for p_bg in psutil.process_iter(['pid']):
            if p_bg.info['pid'] != game_proc.pid and p_bg.info['pid'] != current_pid:
                try: psutil.Process(p_bg.info['pid']).cpu_affinity(HELPER_P_CLUSTER)
                except (psutil.NoSuchProcess, psutil.AccessDenied): continue
        return True
    except: return False

def monitor_united_matrix(game_proc):
    in_overdrive = False
    cooldown_until = 0.0
    
    while game_proc.is_running():
        cpu_loads = psutil.cpu_percent(interval=0.05, percpu=True)
        if not cpu_loads or len(cpu_loads) < 24: continue
        
        helpers_avg = sum([cpu_loads[i] for i in HELPER_P_CLUSTER]) / len(HELPER_P_CLUSTER)
        current_time = time.time()
        
        if helpers_avg > 75.0:
            cooldown_until = current_time + 2.0
            if not in_overdrive:
                game_proc.cpu_affinity(PRIME_S_CONTOUR + SPARE_RESERVE)
                in_overdrive = True
                print("[MATRIX OVERDRIVE] Жесткий замес! Подключен ЗАПАСНОЙ ЦЫПЛЁНОК.")
        
        elif in_overdrive and current_time > cooldown_until:
            game_proc.cpu_affinity(PRIME_S_CONTOUR)
            in_overdrive = False
            print("[MATRIX CHILL] Баланс восстановлен. Память и чипы в холодном режиме.")
            
        time.sleep(0.05)

if __name__ == "__main__":
    print(f"==================================================")
    print(f"   LAUNCHING MATRIX ENGINE: {VERSION}   ")
    print(f"==================================================")
    print("Статус: Мониторинг запущен. Ожидание запуска любой игры...")
    
    while True:
        detected_game = find_active_game()
        if detected_game:
            if apply_v7_matrix(detected_game):
                monitor_united_matrix(detected_game)
                print("\n[MATRIX STOP] Игра закрыта. Очистка буферов.")
                time.sleep(3)
        time.sleep(2)
