void OptimizeWindowsTimer() {
    HMODULE ntdll = GetModuleHandleA("ntdll.dll");
    if (!ntdll) {
        Logger::Log("TIMER: ntdll.dll not found");
        return;
    }

    typedef LONG(WINAPI* NtSetTimerResolutionPtr)(ULONG, BOOLEAN, PULONG);
    auto NtSetTimerResolution = (NtSetTimerResolutionPtr)GetProcAddress(ntdll, "NtSetTimerResolution");
    if (!NtSetTimerResolution) {
        Logger::Log("TIMER: NtSetTimerResolution not found");
        return;
    }

    ULONG currentRes = 0;
    LONG status = NtSetTimerResolution(5000, TRUE, &currentRes);
    if (status == 0) {
        timerSet = true;
        timerResolution = currentRes;
        Logger::Log("TIMER: Set to 0.5ms (current: " + std::to_string(currentRes) + ")");
    } else {
        Logger::Log("TIMER: Failed with status " + std::to_string(status));
    }
}

