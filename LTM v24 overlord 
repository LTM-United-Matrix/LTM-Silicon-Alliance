bool SetProcessCores(DWORD pid, DWORD_PTR affinityMask) {
    HANDLE hProcess = OpenProcess(PROCESS_SET_INFORMATION, FALSE, pid);
    if (!hProcess) return false;
    BOOL result = SetProcessAffinityMask(hProcess, affinityMask);
    CloseHandle(hProcess);
    return result != FALSE;
}

void RestrictBackgroundProcesses() {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) {
        Logger::Log("BG: Failed to create snapshot");
        return;
    }

    PROCESSENTRY32 pe;
    pe.dwSize = sizeof(PROCESSENTRY32);
    DWORD ourPid = GetCurrentProcessId();
    int restricted = 0, skipped = 0;

    if (Process32First(hSnapshot, &pe)) {
        do {
            // Пропускаем систему и себя
            if (pe.th32ProcessID == 0 || pe.th32ProcessID == 4 ||
                pe.th32ProcessID == ourPid || pe.th32ProcessID == activeGamePid) {
                skipped++;
                continue;
            }

            // Проверяем блеклист
            std::string pName = ToLower(pe.szExeFile);
            bool blacklisted = false;
            for (const auto& bl : SYSTEM_BLACKLIST) {
                if (pName == ToLower(bl)) { blacklisted = true; break; }
            }

            if (blacklisted) {
                skipped++;
                continue;
            }

            if (SetProcessCores(pe.th32ProcessID, HELPER_CORES)) {
                restricted++;
            } else {
                skipped++;
            }

        } while (Process32Next(hSnapshot, &pe));
    }

    CloseHandle(hSnapshot);
    Logger::Log("BG: " + std::to_string(restricted) + " restricted, " +
                std::to_string(skipped) + " skipped");
}

void RestoreSystemProcesses() {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return;

    PROCESSENTRY32 pe;
    pe.dwSize = sizeof(PROCESSENTRY32);
    DWORD ourPid = GetCurrentProcessId();
    int restored = 0;

    if (Process32First(hSnapshot, &pe)) {
        do {
            if (pe.th32ProcessID == 0 || pe.th32ProcessID == 4 ||
                pe.th32ProcessID == ourPid) continue;
            if (SetProcessCores(pe.th32ProcessID, ALL_CORES)) restored++;
        } while (Process32Next(hSnapshot, &pe));
    }

    CloseHandle(hSnapshot);
    Logger::Log("RESTORE: " + std::to_string(restored) + " processes restored");
}

void CleanSystemMemory() {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return;

    PROCESSENTRY32 pe;
    pe.dwSize = sizeof(PROCESSENTRY32);
    DWORD ourPid = GetCurrentProcessId();
    int cleaned = 0;

    if (Process32First(hSnapshot, &pe)) {
        do {
            if (pe.th32ProcessID == 0 || pe.th32ProcessID == 4 ||
                pe.th32ProcessID == ourPid || pe.th32ProcessID == activeGamePid) continue;

            HANDLE hProc = OpenProcess(PROCESS_SET_QUOTA | PROCESS_QUERY_INFORMATION,
                                       FALSE, pe.th32ProcessID);
            if (hProc) {
                EmptyWorkingSet(hProc);
                CloseHandle(hProc);
                cleaned++;
            }
        } while (Process32Next(hSnapshot, &pe));
    }

    CloseHandle(hSnapshot);
    Logger::Log("CLEAN: " + std::to_string(cleaned) + " processes cleaned");
}

