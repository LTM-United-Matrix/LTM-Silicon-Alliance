bool DetectDualChannel() {
    MEMORYSTATUSEX memStatus;
    memStatus.dwLength = sizeof(memStatus);
    if (!GlobalMemoryStatusEx(&memStatus)) {
        Logger::Log("MEM: Failed to query memory status");
        return false;
    }

    ULONGLONG totalGB = memStatus.ullTotalPhys / (1024ULL * 1024ULL * 1024ULL);
    Logger::Log("MEM: Total RAM = " + std::to_string(totalGB) + " GB");

    // Эвристика: > 16 ГБ = скорее всего двухканал
    bool detected = totalGB > 16;
    Logger::Log("MEM: Dual channel detected = " + std::string(detected ? "YES" : "NO"));
    return detected;
}

