// Переменные контроля глобального состояния
bool isOvertimeActive = false;
bool isTransitioning = false;
auto overtimeStartTime = std::chrono::steady_clock::now();
std::string globalActiveGame = "НЕТ (Ожидание...)";
std::string globalActiveMode = "---";
std::string globalNetStatus = "[ОЖИДАНИЕ]";

void ResetConsoleCursor() {
    COORD coord = { 0, 0 };
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

void HideConsoleCursor() {
    CONSOLE_CURSOR_INFO cursorInfo;
    GetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &cursorInfo);
    cursorInfo.bVisible = FALSE;
    SetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &cursorInfo);
}

// Из v21s: Активация 60-секундного Овертайма с бескомпромиссным REALTIME приоритетом
void HandleOvertime(HANDLE gameHandle, const std::string& mode) {
    if (mode != "esports") return;
    if (!isOvertimeActive) {
        isOvertimeActive = true;
        overtimeStartTime = std::chrono::steady_clock::now();
        
        SetNvidiaPowerLimit(GTX1080TI_OVERTIME_PL);
        SetPriorityClass(gameHandle, REALTIME_PRIORITY_CLASS); 
    }
    if (isOvertimeActive) {
        auto currentTime = std::chrono::steady_clock::now();
        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(currentTime - overtimeStartTime).count();
        if (elapsed >= 60) {
            isOvertimeActive = false;
            SetNvidiaPowerLimit(GTX1080TI_BASE_PL);
            SetPriorityClass(gameHandle, HIGH_PRIORITY_CLASS); // Безопасный откат до Высокого
        }
    }
}

// Наша технология плавного выхода (Smooth Landing)
void ExecuteSmoothLanding() {
    isTransitioning = true;
    globalActiveGame = "ВЫХОД (Стабилизация ресурсов...)";
    
    SetNetworkGamingTweak(0xFFFFFFFF); 
    SetMaxTimerResolution(false); 
    globalNetStatus = "[ОТКЛЮЧЕН]";

    RestoreSystemProcesses();
    
    // Ступенчатый сброс питания для защиты VRM турбины MSI Aero
    SetNvidiaPowerLimit(260);
    std::this_thread::sleep_for(std::chrono::milliseconds(1500));
    SetNvidiaPowerLimit(GTX1080TI_BASE_PL);
    std::this_thread::sleep_for(std::chrono::milliseconds(1500));
    
    isOvertimeActive = false;
    isTransitioning = false;
    globalActiveGame = "НЕТ (Ожидание...)";
    globalActiveMode = "---";
}

