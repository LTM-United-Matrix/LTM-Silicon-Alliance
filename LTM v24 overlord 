bool FindActiveGame(DWORD& outPid, std::string& outName) {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return false;

    PROCESSENTRY32 pe;
    pe.dwSize = sizeof(PROCESSENTRY32);
    bool found = false;

    if (Process32First(hSnapshot, &pe)) {
        do {
            std::string pName = ToLower(pe.szExeFile);

            // Проверяем вайтлист — только игры из списка
            bool whitelisted = false;
            for (const auto& wl : GAME_WHITELIST) {
                if (pName == ToLower(wl)) { whitelisted = true; break; }
            }

            if (whitelisted) {
                outPid = pe.th32ProcessID;
                outName = pe.szExeFile;
                found = true;
                break;
            }

        } while (Process32Next(hSnapshot, &pe));
    }

    CloseHandle(hSnapshot);
    return found;
}

