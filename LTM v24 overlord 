// MEMORY BRIDGE (из v18.5)
// ================================================================================

std::vector<std::vector<char>> numaBanks;
std::mutex banksMutex;

void AllocateMemoryBanks() {
    std::lock_guard<std::mutex> lock(banksMutex);
    numaBanks.clear();

    int bankSizeMB = isDualChannel ? 256 : 512;
    int bankCount = isDualChannel ? 2 : 4;

    Logger::Log("MEM: Allocating " + std::to_string(bankCount) + " banks, " +
                std::to_string(bankSizeMB) + " MB each");

    for (int i = 0; i < bankCount; i++) {
        try {
            std::vector<char> bank(static_cast<size_t>(bankSizeMB) * 1024ULL * 1024ULL);
            // Заполняем, чтобы память реально выделилась
            std::fill(bank.begin(), bank.end(), 0);
            numaBanks.push_back(std::move(bank));
            Logger::Log("MEM: Bank " + std::to_string(i) + " allocated");
        } catch (const std::bad_alloc&) {
            Logger::Log("MEM: FAILED to allocate bank " + std::to_string(i) + " — out of memory");
            // Пробуем меньший размер
            try {
                std::vector<char> bank(static_cast<size_t>(bankSizeMB / 2) * 1024ULL * 1024ULL);
                std::fill(bank.begin(), bank.end(), 0);
                numaBanks.push_back(std::move(bank));
                Logger::Log("MEM: Bank " + std::to_string(i) + " allocated at half size");
            } catch (const std::bad_alloc&) {
                Logger::Log("MEM: Bank " + std::to_string(i) + " skipped entirely");
            }
        }
    }

    EmptyWorkingSet(GetCurrentProcess());
}

void ClearMemoryBanks() {
    std::lock_guard<std::mutex> lock(banksMutex);
    numaBanks.clear();
    EmptyWorkingSet(GetCurrentProcess());
    Logger::Log("MEM: All banks cleared");
}

