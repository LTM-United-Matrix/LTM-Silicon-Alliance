# Фиксируем любую найденную игру строго на первых 4 потоках твоего Xeon (0, 1, 2, 3)
# Это изолирует её от фонового шума Windows и обходит задержки одноканала Kingston
PRIME_S_CONTOUR = 

# Черный список процессов, которые программа НИКОГДА не посчитает игрой
SYSTEM_BLACKLIST = {
    "explorer.exe", "discord.exe", "chrome.exe", "browser.exe", "vk.exe",
    "steam.exe", "telegram.exe", "python.exe", "cmd.exe", "taskmgr.exe",
    "svchost.exe", "system", "idle", "aida64.exe", "vkmessenger.exe"
}

def find_active_game():
    """Автоматический поиск любой запущенной игры в Windows"""
    try:
        for proc in psutil.process_iter(['pid', 'name']):
            p_name = proc.info['name'].lower()
            
            # Пропускаем системные утилиты и фоновый софт
            if p_name in SYSTEM_BLACKLIST or p_name.startswith("nvidia") or p_name.startswith("amd"):
                continue
                
            try:
                p_handle = psutil.Process(proc.info['pid'])
                # Игры обычно имеют много открытых потоков (больше 15)
                if p_handle.num_threads() > 15 and not p_name.startswith("svchost"):
                    return p_handle
            except (psutil.NoSuchProcess, psutil.AccessDenied):
                continue
    except:
        pass
    return None

def apply_base_ltm(game_proc):
    try:
        g_name = game_proc.name()
        # Привязываем процесс найденной игры к выбранным ядрам
        game_proc.cpu_affinity(PRIME_S_CONTOUR)
        
        # Выставляем высокий приоритет в системе, чтобы кадры шли стабильно
        game_proc.nice(psutil.HIGH_PRIORITY_CLASS)
        
        print(f"\n[LTM v1.0 DETECTED] Обнаружена игра: {g_name} (PID: {game_proc.pid})")
        print(f"[ПРАЙМ] Потоки {PRIME_S_CONTOUR} выделены под {g_name}. Одноканал обойдён!")
        return True
    except Exception as e:
        return False

