# --- SYSTEM ENGINE: MEMORY LOW TRICK (LTM) v14.0 [POWER SPIKE MATRIX] ---
import os
import sys
import time
import ctypes
import subprocess
import psutil

VERSION = "LTM v14.0 (Power Spike Matrix)"

# --- МАТРИЦА СВЯЗИ ЯДЕР CPU ---
PRIME_S_CONTOUR =         # Игровой Прайм (Потоки 0, 1, 2, 3)
HELPER_P_CLUSTER = list(range(4, 24))  # Помощники "на чиле" (20 потоков)
SPARE_RESERVE =      # ЗАПАСНОЙ ЦЫПЛЁНОК (Потоки 24, 25, 26, 27)

# --- УЛЬТИМАТИВНЫЕ ЛИМИТЫ ПИТАНИЯ ДЛЯ РЕЗКОЙ ОТРИСОВКИ ---
GPU_POWER_CHILL = 160  # Глубокий холодный андервольт для меню и закрытых зон
GPU_POWER_BOOST = 250  # МГНОВЕННЫЙ ВПРЫСК ТОКА НА ОТРЕЗКЕ ВЫХОДА (МАКСИМУМ 250W!)

SYSTEM_BLACKLIST = {
    "explorer.exe", "discord.exe", "chrome.exe", "browser.exe", "vk.exe",
    "steam.exe", "telegram.exe", "python.exe", "cmd.exe", "taskmgr.exe",
    "svchost.exe", "system", "idle", "aida64.exe", "vkmessenger.exe"
}

NUMA_LOCAL_DOMAINS = []

def set_advanced_precache_policy():
    try:
        ntdll = ctypes.WinDLL('ntdll.dll')
        ntdll.NtSetTimerResolution(5000, 1, ctypes.byref(ctypes.c_ulong()))
        ctypes.windll.kernel32.SetPriorityClass(ctypes.windll.kernel32.GetCurrentProcess(), 0x00000100) # REALTIME
        ctypes.windll.user32.SetThreadDpiAwarenessContext(ctypes.c_void_p(-4))
        print("[LTM PRE-CACHE] Опережающий рендеринг и таймер 0.5 мс активны.")
    except: pass

def run_nv_cmd(args):
    try:
        nv_path = "C:\\Program Files\\NVIDIA Corporation\\NVSMI\\nvidia-smi.exe"
        if not os.path.exists(nv_path): nv_path = "nvidia-smi"
        cmd = [nv_path] + args
        result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        return result.stdout
    except: return ""

def get_gpu_data():
    out = run_nv_cmd(["--query-gpu=temperature.gpu,utilization.gpu", "--format=csv,noheader,nounits"])
    try:
        parts = out.strip().split(',')
        return int(parts), int(parts)
    except: return 0, 0

def set_gpu_power(watts):
    run_nv_cmd(["-pl", str(watts)])

def ltm_vram_direct_bypass():
    global NUMA_LOCAL_DOMAINS
    try:
        NUMA_LOCAL_DOMAINS.clear()
        for i in range(2):
            allocated_bank = bytearray(256 * 1024 * 1024)
            NUMA_LOCAL_DOMAINS.append(allocated_bank)
        run_nv_cmd(["--gpu-reset"]) 
        ctypes.windll.psapi.EmptyWorkingSet(ctypes.windll.kernel32.GetCurrentProcess())
    except: pass

def find_active_game():
    try:
        for proc in psutil.process_iter(['pid', 'name']):
            p_name = proc.info['name'].lower()
            if p_name in SYSTEM_BLACKLIST or p_name.startswith("nvidia") or p_name.startswith("amd"):
                continue
            try:
                p_handle = psutil.Process(proc.info['pid'])
                if p_handle.num_threads() > 15 and not p_name.startswith("svchost"):
                    return p_handle
            except (psutil.NoSuchProcess, psutil.AccessDenied): continue
    except: pass
    return None

def apply_v14_matrix(game_proc):
    try:
        ltm_vram_direct_bypass()
        set_advanced_precache_policy()
        
        game_proc.cpu_affinity(PRIME_S_CONTOUR)
        game_proc.nice(psutil.REALTIME_PRIORITY_CLASS)
        if hasattr(game_proc, 'ionice'):
            game_proc.ionice(psutil.IOPRIO_HIGH)
            
        set_gpu_power(GPU_POWER_CHILL)
        print(f"\n[MATRIX v14.0] Сверхрезкий силовой конвейер запущен!")
        return True
    except: return False

def monitor_united_matrix(game_proc):
    in_overdrive = False
    cooldown_until = 0.0
    
    while game_proc.is_running():
        cpu_loads = psutil.cpu_percent(interval=0.05, percpu=True)
        if not cpu_loads or len(cpu_loads) < 24: continue
        
        helpers_avg = sum([cpu_loads[i] for i in HELPER_P_CLUSTER]) / len(HELPER_P_CLUSTER)
        gpu_temp, gpu_load = get_gpu_data()
        current_time = time.time()
        
        if gpu_load > 70 and helpers_avg < 60:
            cooldown_until = current_time + 1.5  # Держим пик тока 1.5 секунды для прогрузки
            if not in_overdrive:
                set_gpu_power(GPU_POWER_BOOST)  # РЕЗКО ВРУБАЕМ 250 ВАТТ!
                game_proc.cpu_affinity(PRIME_S_CONTOUR)
                in_overdrive = True
                print("[MATRIX -> INSTANT POWER] Вливаем 250W в 1080 Ti для мгновенной отрисовки!")
        
        elif helpers_avg > 75.0 and gpu_load < 60:
            cooldown_until = current_time + 2.0
            if not in_overdrive:
                game_proc.cpu_affinity(PRIME_S_CONTOUR + SPARE_RESERVE)
                set_gpu_power(GPU_POWER_CHILL)
                in_overdrive = True
                print("[MATRIX -> CPU BOOST] Дым! Зажимаем карту, бустим ядра ЦП.")
                
        elif in_overdrive and current_time > cooldown_until:
            game_proc.cpu_affinity(PRIME_S_CONTOUR)
            set_gpu_power(GPU_POWER_CHILL)
            in_overdrive = False
            print("[MATRIX CHILL] Локация отрисована. Карта сбросила аппетит.")
            
        time.sleep(0.05)

if __name__ == "__main__":
    print(f"==================================================")
    print(f"   LAUNCHING POWER ENGINE: {VERSION}   ")
    print(f"==================================================")
    print("Статус: Ожидание запуска игры...")
    
    while True:
        detected_game = find_active_game()
        if detected_game:
            if apply_v14_matrix(detected_game):
                monitor_united_matrix(detected_game)
                print("\n[MATRIX STOP] Игра закрыта. Сброс лимитов питания.")
                NUMA_LOCAL_DOMAINS.clear()
                set_gpu_power(250) 
                time.sleep(3)
        time.sleep(2)
