# --- SYSTEM ENGINE: MEMORY LOW TRICK (LTM) v2.0 [RAM CLEANER] ---
import os
import sys
import time
import ctypes
import psutil

VERSION = "LTM Base v2.0 (RAM Cleaner)"

PRIME_S_CONTOUR =        # Игровой Прайм (Потоки 0, 1, 2, 3)

SYSTEM_BLACKLIST = {
    "explorer.exe", "discord.exe", "chrome.exe", "browser.exe", "vk.exe",
    "steam.exe", "telegram.exe", "python.exe", "cmd.exe", "taskmgr.exe",
    "svchost.exe", "system", "idle", "aida64.exe", "vkmessenger.exe"
}

def clean_system_memory():
    """ФИШКА v2.0: Принудительная зачистка ОЗУ перед каткой"""
    try:
        ctypes.windll.psapi.EmptyWorkingSet(ctypes.windll.kernel32.GetCurrentProcess())
        print("[LTM MEMORY] Оперативная память Kingston успешно очищена от системного хлама!")
    except:
        pass

def find_active_game():
    try:
        for proc in psutil.process_iter(['pid', 'name']):
            p_name = proc.info['name'].lower()
            if p_name in SYSTEM_BLACKLIST or p_name.startswith("nvidia") or p_name.startswith("amd"):
                continue
            try:
                p_handle = psutil.Process(proc.info['pid'])
                if p_handle.num_threads() > 15 and not p_name.startswith("svchost"):
                    return p_handle
            except (psutil.NoSuchProcess, psutil.AccessDenied): continue
    except: pass
    return None

def apply_v2_ltm(game_proc):
    try:
        g_name = game_proc.name()
        clean_system_memory() # Запуск зачистки памяти
        
        game_proc.cpu_affinity(PRIME_S_CONTOUR)
        game_proc.nice(psutil.HIGH_PRIORITY_CLASS)
        
        print(f"\n[LTM v2.0 DETECTED] Обнаружена игра: {g_name}")
        print(f"[ПРАЙМ] Потоки {PRIME_S_CONTOUR} выделены. Одноканал обойдён!")
        return True
    except:
        return False

if __name__ == "__main__":
    print(f"==================================================")
    print(f"   ACTIVATING ENGINE: {VERSION}   ")
    print(f"==================================================")
    print("Статус: Сканирование системы в поиске запущенной игры...")
    
    while True:
        detected_game = find_active_game()
        if detected_game:
            if apply_v2_ltm(detected_game):
                while detected_game.is_running():
                    time.sleep(1)
                print("\n[LTM STOP] Игра закрыта. Ожидание следующей катки...")
        time.sleep(2)
