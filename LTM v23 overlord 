/*
 * Безопасная установка лимита мощности GPU через CreateProcess.
 * ИСПРАВЛЕНИЕ: замена std::system (которая вызывает C4996 в VS2022)
 * на CreateProcessA. Это также устраняет уязвимость Command Injection.
 */
bool SetNvidiaPowerLimit(int wattage) {
    // Проверка диапазона
    if (wattage < GPU_POWER_MIN || wattage > GPU_POWER_MAX) {
        std::cerr << "[LTM] ОШИБКА: Мощность GPU должна быть в диапазоне "
                  << GPU_POWER_MIN << "-" << GPU_POWER_MAX << " Вт." << std::endl;
        std::cerr << "[LTM]   Запрошено: " << wattage << " Вт." << std::endl;
        return false;
    }

    std::string cmdLine = "nvidia-smi -pl " + std::to_string(wattage);

    std::cout << "[LTM] Выполнение: " << cmdLine << std::endl;

    STARTUPINFOA si;
    ZeroMemory(&si, sizeof(si));
    si.cb = sizeof(si);
    si.dwFlags = STARTF_USESHOWWINDOW;
    si.wShowWindow = SW_HIDE;  // Без окна командной строки

    PROCESS_INFORMATION pi;
    ZeroMemory(&pi, sizeof(pi));

    // Создаём копию строки, так как CreateProcessA может её модифицировать
    std::vector<char> cmdLineBuffer(cmdLine.begin(), cmdLine.end());
    cmdLineBuffer.push_back('\0');

    BOOL success = CreateProcessA(
        NULL,                       // No module name (use command line)
        cmdLineBuffer.data(),       // Command line
        NULL,                       // Process handle not inheritable
        NULL,                       // Thread handle not inheritable
        FALSE,                      // Set handle inheritance to FALSE
        CREATE_NO_WINDOW,           // No console window
        NULL,                       // Use parent's environment block
        NULL,                       // Use parent's starting directory
        &si,                        // Pointer to STARTUPINFO structure
        &pi                         // Pointer to PROCESS_INFORMATION structure
    );

    if (!success) {
        std::cerr << "[LTM] ОШИБКА запуска nvidia-smi: " << GetLastErrorAsString() << std::endl;
        std::cerr << "[LTM]   Проверьте, что nvidia-smi доступен в PATH." << std::endl;
        std::cerr << "[LTM]   Проверьте, что программа запущена от Администратора." << std::endl;
        return false;
    }

    // Ждём завершения с таймаутом
    DWORD waitResult = WaitForSingleObject(pi.hProcess, NVIDIA_SMI_TIMEOUT_MS);

    bool result = false;

    if (waitResult == WAIT_OBJECT_0) {
        DWORD exitCode = 0;
        if (GetExitCodeProcess(pi.hProcess, &exitCode)) {
            if (exitCode == 0) {
                std::cout << "[LTM] Мощность GPU установлена на " << wattage << " Вт." << std::endl;
                result = true;
            } else {
                std::cerr << "[LTM] ОШИБКА: nvidia-smi завершился с кодом " << exitCode << std::endl;
            }
        }
    } else if (waitResult == WAIT_TIMEOUT) {
        std::cerr << "[LTM] ОШИБКА: nvidia-smi не ответил за "
                  << NVIDIA_SMI_TIMEOUT_MS / 1000 << " сек." << std::endl;
        TerminateProcess(pi.hProcess, 1);
    } else {
        std::cerr << "[LTM] ОШИБКА: Сбой ожидания nvidia-smi: " << GetLastErrorAsString() << std::endl;
    }

    // Закрываем дескрипторы процесса и потока
    CloseHandle(pi.hProcess);
    CloseHandle(pi.hThread);

    return result;
}

