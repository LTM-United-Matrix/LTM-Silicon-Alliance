    std::system("cls");
    HideConsoleCursor();
    SetWindowTextA(GetConsoleWindow(), "LTM v23 S // Unified");

    std::vector<GameProfile> db = LoadDatabase();
    bool gameWasRunning = false;
    DWORD targetPid = 0;

    while (true) {
        std::string foundName = "";
        std::string foundMode = "";
        targetPid = FindActiveGamePid(db, foundName, foundMode);

        if (targetPid != 0) {
            if (!gameWasRunning) {
                gameWasRunning = true;
                globalActiveGame = foundName;
                globalActiveMode = foundMode;
                
                HANDLE gameHandle = OpenProcess(PROCESS_SET_INFORMATION, FALSE, targetPid);
                if (gameHandle) {
                    // Разделение труда: игру на 20 ядер, систему на 4 ядра
                    SetProcessAffinityMask(gameHandle, GAME_CORE_MASK);
                    RestrictBackgroundProcesses(targetPid);
                    CloseHandle(gameHandle);
                }
            }
            
            HANDLE gameHandle = OpenProcess(PROCESS_SET_INFORMATION | PROCESS_QUERY_INFORMATION, FALSE, targetPid);
            if (gameHandle) {
                HandleOvertime(gameHandle, foundMode);
                CloseHandle(gameHandle);
            }
        } 
        else if (targetPid == 0 && gameWasRunning) {
            gameWasRunning = false;
            ExecuteSmoothLanding();
        }

        RenderCyberHUD();
        std::this_thread::sleep_for(std::chrono::seconds(1)); // Мониторинг раз в 1 секунду
