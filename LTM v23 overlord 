/*
 * Поиск активной игры в списке процессов.
 * ИСПРАВЛЕНИЕ: имена сравниваются в нижнем регистре.
 * Теперь "CS2.EXE" и "cs2.exe" находятся одинаково.
 */
bool FindActiveGamePid(const std::vector<GameEntry>& database,
                       DWORD& outPid,
                       std::string& outGameName,
                       int& outTargetGpuPower) {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) {
        std::cerr << "[LTM] ОШИБКА: Не удалось создать снимок процессов: "
                  << GetLastErrorAsString() << std::endl;
        return false;
    }

    PROCESSENTRY32 pe32;
    pe32.dwSize = sizeof(PROCESSENTRY32);

    bool found = false;

    if (Process32First(hSnapshot, &pe32)) {
        do {
            std::string procNameLower = ToLower(pe32.szExeFile);

            for (const auto& game : database) {
                if (procNameLower == ToLower(game.name)) {
                    outPid            = pe32.th32ProcessID;
                    outGameName       = game.name;
                    outTargetGpuPower = game.targetGpuPower;
                    found = true;
                    break;
                }
            }
        } while (!found && Process32Next(hSnapshot, &pe32));
    }

    CloseHandle(hSnapshot);
    return found;
}

