// Адаптация под железо: Intel Xeon E5-2680 (24 потока) и MSI Aero GTX 1080 Ti
const int GTX1080TI_BASE_PL = 250;
const int GTX1080TI_OVERTIME_PL = 275;
const DWORD_PTR SYSTEM_CORE_MASK = 0x0F;       // Потоки 0-3 под Windows и фоновый софт
const DWORD_PTR GAME_CORE_MASK = 0xFFFFF0;     // Потоки 4-23 чистыми под игру

struct GameProfile {
    std::string name;
    std::string mode;
};

// Глобальное состояние утилиты
bool isOvertimeActive = false;
bool isTransitioning = false;
auto overtimeStartTime = std::chrono::steady_clock::now();
std::string globalActiveGame = "НЕТ (Ожидание...)";
std::string globalActiveMode = "---";

void ResetConsoleCursor() {
    COORD coord = { 0, 0 };
    SetConsoleCursorPosition(GetStdHandle(STD_OUTPUT_HANDLE), coord);
}

void HideConsoleCursor() {
    CONSOLE_CURSOR_INFO cursorInfo;
    GetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &cursorInfo);
    cursorInfo.bVisible = FALSE;
    SetConsoleCursorInfo(GetStdHandle(STD_OUTPUT_HANDLE), &cursorInfo);
}

// Управление лимитами MSI Aero 1080 Ti через системную утилиту драйвера
void SetNvidiaPowerLimit(int wattage) {
    if (std::system("where nvidia-smi > nul 2>&1") == 0) {
        std::string cmd = "nvidia-smi -pl " + std::to_string(wattage) + " > nul 2>&1";
        std::system(cmd.c_str());
    }
}

// Принудительное выселение фонового софта на системные ядра
void RestrictBackgroundProcesses(DWORD gamePid) {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return;
    PROCESSENTRY32 pe = { sizeof(PROCESSENTRY32) };

    if (Process32First(hSnapshot, &pe)) {
        do {
            if (pe.th32ProcessID != gamePid && pe.th32ProcessID != 0 && pe.th32ProcessID != 4) {
                HANDLE hProcess = OpenProcess(PROCESS_SET_INFORMATION, FALSE, pe.th32ProcessID);
                if (hProcess) {
                    SetProcessAffinityMask(hProcess, SYSTEM_CORE_MASK);
                    CloseHandle(hProcess);
                }
            }
        } while (Process32Next(hSnapshot, &pe));
    }
    CloseHandle(hSnapshot);
}

// Возврат фонового софта на все потоки Xeon после закрытия игры
void RestoreSystemProcesses() {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return;
    PROCESSENTRY32 pe = { sizeof(PROCESSENTRY32) };

    if (Process32First(hSnapshot, &pe)) {
        do {
            if (pe.th32ProcessID != 0 && pe.th32ProcessID != 4) {
                HANDLE hProcess = OpenProcess(PROCESS_SET_INFORMATION, FALSE, pe.th32ProcessID);
                if (hProcess) {
                    SetProcessAffinityMask(hProcess, (DWORD_PTR)-1);
                    CloseHandle(hProcess);
                }
            }
        } while (Process32Next(hSnapshot, &pe));
    }
    CloseHandle(hSnapshot);
}

// Чтение базы ltm_database.txt с поддержкой профилей esports / casual
std::vector<GameProfile> LoadDatabase() {
    std::vector<GameProfile> profiles;
    std::ifstream file("ltm_database.txt");
    if (!file) {
        std::ofstream createDb("ltm_database.txt");
        createDb << "cs2.exe esports\ncsgo.exe esports\ndota2.exe esports\ncyberpunk2077.exe casual\n";
        createDb.close();
        profiles.push_back({"cs2.exe", "esports"});
        profiles.push_back({"csgo.exe", "esports"});
        profiles.push_back({"dota2.exe", "esports"});
        profiles.push_back({"cyberpunk2077.exe", "casual"});
        return profiles;
    }
    std::string line;
    while (std::getline(file, line)) {
        std::stringstream ss(line);
        std::string name, mode;
        if (ss >> name >> mode) profiles.push_back({name, mode});
    }
    return profiles;
}

DWORD FindActiveGamePid(const std::vector<GameProfile>& db, std::string& foundName, std::string& foundMode) {
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return 0;
    PROCESSENTRY32 pe = { sizeof(PROCESSENTRY32) };

    if (Process32First(hSnapshot, &pe)) {
        do {
            std::string procName(pe.szExeFile);
            std::transform(procName.begin(), procName.end(), procName.begin(), ::tolower);
            for (const auto& game : db) {
                std::string target = game.name;
                std::transform(target.begin(), target.end(), target.begin(), ::tolower);
                if (procName == target) {
                    foundName = game.name;
                    foundMode = game.mode;
                    CloseHandle(hSnapshot);
                    return pe.th32ProcessID;
                }
            }
        } while (Process32Next(hSnapshot, &pe));
    }
    CloseHandle(hSnapshot);
    return 0;
}

// Логика 60-секундного Овертайма для киберспорта
void HandleOvertime(HANDLE gameHandle, const std::string& mode) {
    if (mode != "esports") return;

    if (!isOvertimeActive) {
        isOvertimeActive = true;
        overtimeStartTime = std::chrono::steady_clock::now();
        SetNvidiaPowerLimit(GTX1080TI_OVERTIME_PL);
        SetPriorityClass(gameHandle, HIGH_PRIORITY_CLASS);
    }

    if (isOvertimeActive) {
        auto currentTime = std::chrono::steady_clock::now();
        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(currentTime - overtimeStartTime).count();
        if (elapsed >= 60) {
            isOvertimeActive = false;
            SetNvidiaPowerLimit(GTX1080TI_BASE_PL);
        }
    }
}

// Технология плавного выхода (Smooth Landing)
void ExecuteSmoothLanding() {
    isTransitioning = true;
    globalActiveGame = "ВЫХОД (Стабилизация ресурсов...)";
    RestoreSystemProcesses();
    
    // Ступенчатый сброс питания для защиты VRM видеокарты
    SetNvidiaPowerLimit(260);
    std::this_thread::sleep_for(std::chrono::milliseconds(1500));
    SetNvidiaPowerLimit(GTX1080TI_BASE_PL);
    std::this_thread::sleep_for(std::chrono::milliseconds(1500));
    
    isOvertimeActive = false;
    isTransitioning = false;
    globalActiveGame = "НЕТ (Ожидание...)";
    globalActiveMode = "---";
}

