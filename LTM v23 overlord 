/*
 * Установка маски ядер для процесса.
 * ВАЖНО: CloseHandle вызывается ВСЕГДА.
 * В оригинальном коде при ошибке SetProcessAffinityMask
 * дескриптор утекал -> BSOD за несколько часов.
 */
bool SetProcessCores(DWORD processId, DWORD_PTR affinityMask) {
    HANDLE hProcess = OpenProcess(PROCESS_SET_INFORMATION, FALSE, processId);

    if (hProcess == NULL) {
        // Процесс защищён (антивирус, критическая служба Windows)
        // Дескриптор не был получен — утечки нет
        return false;
    }

    BOOL result = SetProcessAffinityMask(hProcess, affinityMask);

    // КРИТИЧЕСКОЕ ИСПРАВЛЕНИЕ: CloseHandle ВСЕГДА
    CloseHandle(hProcess);

    return (result != FALSE);
}

/*
 * Однократное ограничение фоновых процессов.
 * Вызывается СТРОГО ОДИН РАЗ при обнаружении игры.
 * В оригинале вызывалось каждую секунду -> огромный оверхед CPU.
 */
void RestrictBackgroundProcesses(DWORD_PTR backgroundCores) {
    std::cout << "[LTM] Ограничение фоновых процессов на ядрах 0x"
              << std::hex << backgroundCores << std::dec << "..." << std::endl;

    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) {
        std::cerr << "[LTM] ОШИБКА: Не удалось создать снимок процессов: "
                  << GetLastErrorAsString() << std::endl;
        return;
    }

    PROCESSENTRY32 pe32;
    pe32.dwSize = sizeof(PROCESSENTRY32);

    int restrictedCount = 0;
    int skippedCount    = 0;
    DWORD ourPid        = GetCurrentProcessId();

    if (Process32First(hSnapshot, &pe32)) {
        do {
            // Пропускаем системные процессы и самих себя
            if (pe32.th32ProcessID == 0 ||
                pe32.th32ProcessID == 4 ||       // System
                pe32.th32ProcessID == ourPid) {   // Наш процесс
                skippedCount++;
                continue;
            }

            if (SetProcessCores(pe32.th32ProcessID, backgroundCores)) {
                restrictedCount++;
            } else {
                skippedCount++;
            }

        } while (Process32Next(hSnapshot, &pe32));
    }

    // Закрываем снапшот (тоже дескриптор!)
    CloseHandle(hSnapshot);

    std::cout << "[LTM] Готово: " << restrictedCount << " процессов ограничено, "
              << skippedCount << " пропущено." << std::endl;
}

/*
 * Восстановление всех процессов на все ядра при выходе из игры.
 * CloseHandle на hSnapshot вызывается ВСЕГДА.
 */
void RestoreSystemProcesses() {
    std::cout << "[LTM] Восстановление всех процессов на все ядра..." << std::endl;

    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) {
        std::cerr << "[LTM] ОШИБКА: Не удалось создать снимок процессов: "
                  << GetLastErrorAsString() << std::endl;
        return;
    }

    PROCESSENTRY32 pe32;
    pe32.dwSize = sizeof(PROCESSENTRY32);

    DWORD ourPid = GetCurrentProcessId();
    int restoredCount = 0;

    if (Process32First(hSnapshot, &pe32)) {
        do {
            if (pe32.th32ProcessID == 0 ||
                pe32.th32ProcessID == 4 ||
                pe32.th32ProcessID == ourPid) {
                continue;
            }

            if (SetProcessCores(pe32.th32ProcessID, ALL_CORES_MASK)) {
                restoredCount++;
            }

        } while (Process32Next(hSnapshot, &pe32));
    }

    CloseHandle(hSnapshot);

    std::cout << "[LTM] Готово: " << restoredCount << " процессов восстановлено." << std::endl;
}

