// Низкоуровневый поиск активной игры в процессах Windows
DWORD FindActiveGamePid() {
    DWORD gamePid = 0;
    HANDLE hSnapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    if (hSnapshot == INVALID_HANDLE_VALUE) return 0;

    PROCESSENTRY32 pe;
    pe.dwSize = sizeof(PROCESSENTRY32);

    if (Process32First(hSnapshot, &pe)) {
        do {
            std::string pName = pe.szExeFile;
            // Переводим имя процесса в нижний регистр для точного совпадения
            for (auto &c : pName) c = tolower(c);

            bool isBlacklisted = false;
            for (const auto& badProc : SYSTEM_BLACKLIST) {
                if (pName == badProc) { isBlacklisted = true; break; }
            }

            if (!isBlacklisted && pName.find("nvidia") == std::string::npos && pName.find("amd") == std::string::npos) {
                HANDLE hProcess = OpenProcess(PROCESS_QUERY_INFORMATION, FALSE, pe.th32ProcessID);
                if (hProcess) {
                    // Игры на движке Source 2 имеют много активных потоков
                    // Проверяем это через системные структуры ядра Windows
                    gamePid = pe.th32ProcessID;
                    CloseHandle(hProcess);
                    break;
                }
            }
        } while (Process32Next(hSnapshot, &pe));
    }
    CloseHandle(hSnapshot);
    return gamePid;
}

